NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://schooltrack:replace-with-local-password@localhost:5432/schooltrack?schema=public
CORS_ORIGINS=http://localhost:4173
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
JWT_ACCESS_SECRET=replace-with-at-least-48-random-characters-for-production
JWT_ISSUER=schooltrack-api
JWT_AUDIENCE=schooltrack-clients
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ENABLE_DEV_REGISTRATION=false
VEHICLE_LOCATION_STALE_SECONDS=300
VEHICLE_LOCATION_RETENTION_DAYS=7
CHECKPOINT_MAX_AGE_SECONDS=86400
EVENT_MAX_FUTURE_SKEW_SECONDS=300
SSE_MAX_CONNECTION_SECONDS=900
TRUST_PROXY=false
# Development seed overrides only; never use these values in production:
# DEMO_SEED_PASSWORD=
# DEMO_DEVICE_TOKEN=
