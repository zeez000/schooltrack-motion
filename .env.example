POSTGRES_DB=schooltrack
POSTGRES_USER=schooltrack
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://schooltrack:replace-with-local-password@postgres:5432/schooltrack?schema=public
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:4173
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ENABLE_DEV_REGISTRATION=false
VEHICLE_LOCATION_STALE_SECONDS=300
VEHICLE_LOCATION_RETENTION_DAYS=7
TRUST_PROXY=false
