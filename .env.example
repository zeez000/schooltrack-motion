POSTGRES_DB=schooltrack
POSTGRES_USER=schooltrack
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql://schooltrack:replace-with-a-long-random-local-password@postgres:5432/schooltrack?schema=public
BACKEND_PORT=4000
CORS_ORIGINS=http://localhost:4173
LOG_LEVEL=info
JWT_ACCESS_SECRET=replace-with-at-least-48-random-characters-for-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
ENABLE_DEV_REGISTRATION=false
VEHICLE_LOCATION_STALE_SECONDS=300
VEHICLE_LOCATION_RETENTION_DAYS=7
CHECKPOINT_MAX_AGE_SECONDS=86400
EVENT_MAX_FUTURE_SKEW_SECONDS=300
SSE_MAX_CONNECTION_SECONDS=900
TRUST_PROXY=false
# Production self-hosting:
# DOMAIN=api.example.com
# CORS_ORIGINS=https://your-frontend.example.com
