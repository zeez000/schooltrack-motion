{
  "name": "schooltrack-motion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SchoolTrack interactive design prototype. All data is fictional.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:backend": "npm --prefix backend run build",
    "dev": "node scripts/serve.mjs",
    "dev:backend": "npm --prefix backend run dev",
    "preview": "node scripts/serve.mjs dist",
    "test": "node --test tests/site.test.mjs",
    "test:backend": "npm --prefix backend test",
    "test:all": "npm test && npm run test:backend"
  },
  "engines": { "node": ">=22" }
}
